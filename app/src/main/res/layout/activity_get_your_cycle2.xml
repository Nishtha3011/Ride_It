<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:id="@+id/main"
    >

    <TextView
        android:id="@+id/get_your_text"
        android:layout_width="170dp"
        android:layout_height="43dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/toasty_milk"
        android:gravity="center"
        android:text="GET YOUR"
        android:textColor="#ED7A52"
        android:textSize="35sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/cycle_text"
        android:layout_width="97dp"
        android:layout_height="42dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="3dp"

        android:fontFamily="@font/toasty_milk"
        android:gravity="center"
        android:text="CYCLE"
        android:textColor="#ED7A52"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/get_your_text"
        tools:text="CYCLE" />

    <ImageView
        android:id="@+id/profile_icon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="52dp"
        android:contentDescription="Profile Icon"
        android:src="@drawable/ic_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.977"
        app:layout_constraintStart_toEndOf="@id/cycle_text"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cycle_image_cardview"
        android:layout_width="327dp"
        android:layout_height="212dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="52dp"
        android:layout_marginEnd="52dp"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="0dp"
        app:strokeColor="#000000"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cycle_text">

        <ImageView
            android:id="@+id/cycle_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Cycle Image"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bike_final"
            android:background="@drawable/dashed_stroke"
            android:padding="40dp"/>

    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/current_location_text"
        android:layout_width="327dp"
        android:layout_height="39dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_edge"
        android:text="CURRENT LOCATION : G-Block\t\t\t\t\t\t\t\t\t\t\t"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="14sp"
        app:cornerRadius="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cycle_image_cardview"
        />


    <TextView
        android:id="@+id/description_textview"
        android:layout_width="327dp"
        android:layout_height="80dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_edge"
        android:gravity="top|start"
        android:padding="16dp"
        android:text="A short description of the cycle"
        android:textColor="#FFFFFF"
        app:cornerRadius="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/current_location_text"
        />

    <LinearLayout
        android:id="@+id/code_container"
        android:layout_width="327dp"
        android:layout_height="31dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/green_round"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description_textview">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Code: 9762"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rental_rate_container"
        android:layout_width="327dp"
        android:layout_height="31dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/green_round"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/code_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Rental Rate:"
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="₹ 2/ 5min"
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drop_location_container"
        android:layout_width="327dp"
        android:layout_height="48dp"
        android:layout_marginStart="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/dropdown_bg"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rental_rate_container">

        <TextView
            android:id="@+id/selected_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choose drop location"
            android:textColor="#000000"
            android:gravity="center_vertical" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="match_parent"

            android:contentDescription="Drop down arrow"
            android:padding="8dp"
            android:src="@drawable/ic_dropdown"
            app:tint="#FFFFFF" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/upiButton"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/txt_bold"
        app:backgroundTint="@android:color/white"
        app:strokeColor="@android:color/black"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/drop_location_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:drawableLeft="@drawable/ic_upi"
        android:drawableTint="#000000"
        android:text="UPI"
    />



</androidx.constraintlayout.widget.ConstraintLayout>