<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AddCycle">

    <!-- Heading -->
    <TextView
        android:id="@+id/addCycleHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD YOUR\nCYCLE"
        android:textColor="#C75A37"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="@font/toasty_milk"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        />

    <!-- User Icon -->
    <ImageView
        android:id="@+id/profileIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_account"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Image upload placeholder -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cycleImageCard"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/addCycleHeading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dashed_stroke"
            >

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                android:contentDescription="Add image" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- Enter current location button -->
    <Button
        android:id="@+id/enter_location_button"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Enter current location"
        android:textColor="#FFFFFF"
        android:backgroundTint="#ED7A52"
        app:cornerRadius="5dp"
        app:layout_constraintTop_toBottomOf="@id/cycleImageCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Description EditText -->
    <EditText
        android:id="@+id/description_edittext"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="#ED7A58"
        android:gravity="top|start"
        android:hint="  Add a short description about the cycle "
        android:padding="16dp"
        android:textColorHint="#FFFFFF"
        android:textColor="#FFFFFF"
        android:inputType="textMultiLine"
        android:maxLines="5"
        app:layout_constraintTop_toBottomOf="@id/enter_location_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <!-- Rental Rate Container -->
    <LinearLayout
        android:id="@+id/rental_rate_container"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:background="#E8E6C9"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/description_edittext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rental Rate:"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 2 / 5min"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Submit Button -->
    <Button
        android:id="@+id/submit_button"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:text="SUBMIT"
        android:textColor="#000000"
        android:backgroundTint="#E8E6C9"
        app:cornerRadius="7dp"
        app:layout_constraintTop_toBottomOf="@id/rental_rate_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
