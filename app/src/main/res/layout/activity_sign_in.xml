<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Your existing views here -->

        <!-- Title -->
        <ImageView
            android:id="@+id/ic_cycle"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_bike_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingEnd="0dp"
            android:paddingTop="16dp"
            />

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/txt_bold"
            android:text="RIDE IT"
            android:textColor="@color/splash_bg"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ic_cycle"
            app:layout_goneMarginTop="0dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="____________create your account___________"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/appName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>

        <!-- Email Field -->
        <TextView
            android:id="@+id/emailtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/emailEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:hint="Email address"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/emailtitle"
            android:textColor="@color/black"/>

        <!-- Registration Number -->
        <TextView
            android:id="@+id/regtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regiistration Number"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/emailEditText"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/regEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Registration Number"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/regtitle"
            app:cornerRadius="10dp"
            android:textColor="@color/black"/>

        <!-- Phone Number -->
        <TextView
            android:id="@+id/phonetitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/regEditText"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/phoneEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Phone Number"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/phonetitle"
            app:cornerRadius="10dp"
            android:textColor="@color/black"/>

        <!-- Full Name -->
        <TextView
            android:id="@+id/nametitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/phoneEditText"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Full Name"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/nametitle"
            app:cornerRadius="10dp"
            android:textColor="@color/black"/>

        <!-- Hostel -->
        <TextView
            android:id="@+id/hosteltitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hostel"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/nameEditText"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/hostelEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Hostel Block"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/hosteltitle"
            app:cornerRadius="10dp"
            android:textColor="@color/black"/>
        <!-- password -->
        <TextView
            android:id="@+id/passwordtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/hostelEditText"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Password"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/passwordtitle"/>
        <!-- confirm password -->
        <TextView
            android:id="@+id/confirmtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Password"
            android:textSize="18sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/passwordEditText"
            android:layout_marginLeft="11dp"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/confirmEditText"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Confirm Password"
            android:background="@color/edittxt"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@+id/confirmtitle"
            app:cornerRadius="10dp"
            android:textColor="@color/black"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signupButton"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:text="Sign Up for Now"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F57C00"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/confirmEditText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="26dp"
            android:fontFamily="@font/txt_bold"
            android:layout_marginTop="36dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
